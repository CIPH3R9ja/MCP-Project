# Claude Audit Monitor – Environment Variables

# Server port (default: 7842)
CAM_PORT=7842

# SQLite database path (default: ~/.claude-audit-monitor/audit.db)
# CAM_DB_PATH=/custom/path/audit.db

# URL used by the hook scripts to reach the server
CAM_URL=http://localhost:7842

# Anthropic API key — required for AI intent analysis
# If omitted, CAM falls back to rule-based analysis (fully offline)
ANTHROPIC_API_KEY=sk-ant-...
